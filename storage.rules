rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // User item attachments
    match /items/{userId}/{fileName} {
      // Public read for item images
      allow read: if request.auth != null;

      // Upload: Authenticated user uploading to their own folder, max 5MB, image only
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|jpg|webp)');
      
      allow delete: if request.auth != null && (
        request.auth.uid == userId ||
        request.auth.token.role == 'admin'
      );
    }
  }
}
