{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "findit",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "NEXT_PUBLIC_DEMO_MODE": "false",
    "NEXT_PUBLIC_APP_URL": "https://findit.findit-us.workers.dev",
    "NODE_ENV": "production",
    "NEXT_PUBLIC_FIREBASE_API_KEY": "AIzaSyCvc9drFTrCVbX8ph2vM9tYRJSPRtQYKiE",
    "NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN": "ethos-school.firebaseapp.com",
    "NEXT_PUBLIC_FIREBASE_PROJECT_ID": "ethos-school",
    "NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET": "ethos-school.firebasestorage.app",
    "NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID": "440474618285",
    "NEXT_PUBLIC_FIREBASE_APP_ID": "1:440474618285:web:7cd660d8a68b1494ddf924"
  },
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "findit-db",
      "database_id": "32d27268-db2b-4234-be20-786855777814"
    }
  ]
}
