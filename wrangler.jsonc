{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "findit",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "NEXT_PUBLIC_DEMO_MODE": "true",
    "NEXT_PUBLIC_APP_URL": "https://findit.findit-us.workers.dev",
    "NODE_ENV": "production"
  },
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "findit-db",
      "database_id": "32d27268-db2b-4234-be20-786855777814"
    }
  ]
}
