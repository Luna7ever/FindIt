{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "app",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "findit-db",
      "database_id": "findit-production-db"
    }
  ]
}
